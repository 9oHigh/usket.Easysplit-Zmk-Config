#!/bin/sh
set -eu
expected_name='9oHigh'
expected_email='usket@icloud.com'
remote_name=${1:-unknown}
remote_url=${2:-}
if [ -z "$remote_url" ]; then
  printf 'Git attribution guard: missing remote URL; push blocked.\n' >&2
  exit 1
fi
while IFS=' ' read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_ref:-}" ] || continue
  zero=$(printf '%s' "$local_oid" | sed 's/./0/g')
  [ "$local_oid" != "$zero" ] || continue
  if [ "$remote_oid" = "$(printf '%s' "$remote_oid" | sed 's/./0/g')" ]; then
    if ! listing=$(git ls-remote "$remote_url" HEAD 2>/dev/null); then
      printf 'Git attribution guard: cannot read %s HEAD; push blocked.\n' "$remote_name" >&2
      exit 1
    fi
    base_oid=$(printf '%s\n' "$listing" | awk '$2 == "HEAD" { print $1; exit }')
    if [ -n "$base_oid" ]; then
      if ! commits=$(git rev-list "$local_oid" --not "$base_oid" 2>/dev/null); then
        printf 'Git attribution guard: cannot inspect commits for %s; push blocked.\n' "$remote_ref" >&2
        exit 1
      fi
    else
      if ! commits=$(git rev-list "$local_oid" 2>/dev/null); then
        printf 'Git attribution guard: cannot inspect new repository history; push blocked.\n' >&2
        exit 1
      fi
    fi
  else
    if ! commits=$(git rev-list "$local_oid" --not "$remote_oid" 2>/dev/null); then
      printf 'Git attribution guard: cannot inspect commits for %s; push blocked.\n' "$remote_ref" >&2
      exit 1
    fi
  fi
  for commit in $commits; do
    if ! identities=$(git show -s --format='%an%x09%ae%x09%cn%x09%ce' "$commit" 2>/dev/null); then
      printf 'Git attribution guard: cannot read commit %s; push blocked.\n' "$commit" >&2
      exit 1
    fi
    author_name=$(printf '%s\n' "$identities" | cut -f1)
    author_email=$(printf '%s\n' "$identities" | cut -f2 | tr '[:upper:]' '[:lower:]')
    committer_name=$(printf '%s\n' "$identities" | cut -f3)
    committer_email=$(printf '%s\n' "$identities" | cut -f4 | tr '[:upper:]' '[:lower:]')
    if [ "$author_name" != "$expected_name" ] || [ "$author_email" != "$expected_email" ]; then
      printf 'Git attribution guard: commit %s author is %s <%s>; expected %s <%s>. Push blocked.\n' "$commit" "$author_name" "$author_email" "$expected_name" "$expected_email" >&2
      exit 1
    fi
    if { [ "$committer_name" = "$expected_name" ] && [ "$committer_email" = "$expected_email" ]; } || { [ "$committer_name" = 'GitHub' ] && [ "$committer_email" = 'noreply@github.com' ]; }; then
      :
    else
      printf 'Git attribution guard: commit %s committer is %s <%s>; expected %s <%s> or GitHub web operation. Push blocked.\n' "$commit" "$committer_name" "$committer_email" "$expected_name" "$expected_email" >&2
      exit 1
    fi
  done
done
