#!/bin/sh
set -eu
expected_name='9oHigh'
expected_email='usket@icloud.com'
extract_name() {
  printf '%s\n' "$1" | sed -n 's/^\(.*\) <[^<>]*> [0-9][0-9]* [+-][0-9][0-9][0-9][0-9]$/\1/p'
}
extract_email() {
  printf '%s\n' "$1" | sed -n 's/^.* <\([^<>]*\)> [0-9][0-9]* [+-][0-9][0-9][0-9][0-9]$/\1/p'
}
for variable in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  if ! identity=$(git var "$variable" 2>/dev/null); then
    printf 'Git attribution guard: cannot resolve %s; commit blocked.\n' "$variable" >&2
    exit 1
  fi
  name=$(extract_name "$identity")
  email=$(extract_email "$identity")
  normalized_email=$(printf '%s' "$email" | tr '[:upper:]' '[:lower:]')
  if [ "$name" != "$expected_name" ] || [ "$normalized_email" != "$expected_email" ]; then
    printf 'Git attribution guard: %s must be %s <%s>; commit blocked.\n' "$variable" "$expected_name" "$expected_email" >&2
    exit 1
  fi
done
